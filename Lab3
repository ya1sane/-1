* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: Arial, sans-serif;
    background: #fff;
    color: #333;
    padding: 20px;
}

header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 10px 20px;
    border-bottom: 2px solid #eee;
}

.logo {
    font-size: 24px;
    font-weight: bold;
    display: flex;
    align-items: center;
}


nav a {
    margin-left: 20px;
    text-decoration: none;
    color: #666;
    font-size: 18px;
}

nav a.active {
    color: #e53935;
    font-weight: bold;
}

.hero {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 50px;
}

.hero-text {
    max-width: 600px;
}

.hero-text h1 {
    font-size: 42px;
    margin-bottom: 20px;
}

.hero-text .bold {
    font-weight: bold;
    color: #000;
}

.hero-text p {
    font-size: 16px;
    margin-bottom: 30px;
    color: #666;
}

.download-btn {
    background: #e53935;
    color: #fff;
    padding: 15px 30px;
    border: none;
    border-radius: 5px;
    font-size: 18px;
    cursor: pointer;
}

.hero-image img {
    max-width: 500px;
    height: auto;
}
